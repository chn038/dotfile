# Rosé Pine palette — main/dark
declare-option str rp_base           "rgb:232136"
declare-option str rp_surface        "rgb:2a273f"
declare-option str rp_overlay        "rgb:393552"
declare-option str rp_muted          "rgb:6e6a86"
declare-option str rp_subtle         "rgb:908caa"
declare-option str rp_text           "rgb:e0def4"
declare-option str rp_love           "rgb:eb6f92"
declare-option str rp_gold           "rgb:f6c177"
declare-option str rp_rose           "rgb:ea9a97"
declare-option str rp_pine           "rgb:3e8fb0"
declare-option str rp_foam           "rgb:9ccfd8"
declare-option str rp_iris           "rgb:c4a7e7"
declare-option str rp_highlight_low  "rgb:2a283e"
declare-option str rp_highlight_med  "rgb:44415a"
declare-option str rp_highlight_high "rgb:56526e"
declare-option str rp_documentation "rgb:a4a0bc"
declare-option str rp_selection     "rgb:44415a"
declare-option str rp_selection_alt "rgb:393552"
declare-option str rp_diff_add_bg   "rgb:1c2a2a"
declare-option str rp_diff_rm_bg    "rgb:2e1f2a"
declare-option str rp_diff_meta_bg  "rgb:2a2440"
declare-option str rp_buffer_pad    "rgb:737182"


# Tree-sitter faces
set-face global ts_attribute                    "%opt{rp_gold}"
set-face global ts_comment                      "%opt{rp_muted}+i"
set-face global ts_comment_unused               "%opt{rp_muted}+is"
set-face global ts_conceal                      "%opt{rp_iris}+i"
set-face global ts_constant                     "%opt{rp_gold}"
set-face global ts_constant_builtin_boolean     "%opt{rp_foam}"
set-face global ts_constant_character           "%opt{rp_rose}"
set-face global ts_constant_macro               "%opt{rp_iris}"
set-face global ts_constructor                  "%opt{rp_foam}"
set-face global ts_diff_plus                    "%opt{rp_foam}"
set-face global ts_diff_minus                   "%opt{rp_love}"
set-face global ts_diff_delta                   "%opt{rp_pine}"
set-face global ts_diff_delta_moved             "%opt{rp_iris}"
set-face global ts_error                        "%opt{rp_love}+b"
set-face global ts_function                     "%opt{rp_rose}"
set-face global ts_function_builtin             "%opt{rp_rose}+i"
set-face global ts_function_macro               "%opt{rp_iris}"
set-face global ts_hint                         "%opt{rp_foam}+b"
set-face global ts_info                         "%opt{rp_foam}+b"
set-face global ts_keyword                      "%opt{rp_iris}"
set-face global ts_keyword_conditional          "%opt{rp_iris}+i"
set-face global ts_keyword_control_conditional  "%opt{rp_iris}+i"
set-face global ts_keyword_control_directive    "%opt{rp_iris}+i"
set-face global ts_keyword_control_import       "%opt{rp_iris}+i"
set-face global ts_keyword_directive            "%opt{rp_iris}+i"
set-face global ts_keyword_storage              "%opt{rp_iris}"
set-face global ts_keyword_storage_modifier     "%opt{rp_iris}"
set-face global ts_keyword_storage_modifier_mut "%opt{rp_iris}"
set-face global ts_keyword_storage_modifier_ref "%opt{rp_foam}"
set-face global ts_label                        "%opt{rp_foam}+i"
set-face global ts_namespace                    "%opt{rp_pine}+i"
set-face global ts_operator                     "%opt{rp_foam}"
set-face global ts_property                     "%opt{rp_foam}"
set-face global ts_punctuation                  "%opt{rp_subtle}"
set-face global ts_punctuation_special          "%opt{rp_foam}"
set-face global ts_special                      "%opt{rp_iris}"
set-face global ts_string                       "%opt{rp_foam}"
set-face global ts_string_regex                 "%opt{rp_love}"
set-face global ts_string_regexp                "%opt{rp_love}"
set-face global ts_string_escape                "%opt{rp_gold}"
set-face global ts_string_special               "%opt{rp_iris}"
set-face global ts_string_special_path          "%opt{rp_foam}"
set-face global ts_string_special_symbol        "%opt{rp_iris}"
set-face global ts_string_symbol                "%opt{rp_rose}"
set-face global ts_tag                          "%opt{rp_iris}"
set-face global ts_tag_error                    "%opt{rp_love}"
set-face global ts_text                         "%opt{rp_text}"
set-face global ts_type                         "%opt{rp_foam}"
set-face global ts_type_enum_variant            "%opt{rp_rose}"
set-face global ts_type_enum_variant_builtin    "%opt{rp_rose}+i"
set-face global ts_variable                     "%opt{rp_text}"
set-face global ts_variable_builtin             "%opt{rp_rose}"
set-face global ts_variable_other_member        "%opt{rp_pine}"
set-face global ts_variable_parameter           "%opt{rp_rose}+i"
set-face global ts_warning                      "%opt{rp_gold}+b"

# Markup
set-face global ts_markup_bold                  "%opt{rp_gold}+b"
set-face global ts_markup_heading               "%opt{rp_iris}"
set-face global ts_markup_heading_1             "%opt{rp_iris}"
set-face global ts_markup_heading_2             "%opt{rp_foam}"
set-face global ts_markup_heading_3             "%opt{rp_rose}"
set-face global ts_markup_heading_4             "%opt{rp_gold}"
set-face global ts_markup_heading_5             "%opt{rp_pine}"
set-face global ts_markup_heading_6             "%opt{rp_foam}"
set-face global ts_markup_heading_marker        "%opt{rp_gold}+b"
set-face global ts_markup_italic                "%opt{rp_rose}+i"
set-face global ts_markup_list_checked          "%opt{rp_foam}"
set-face global ts_markup_list_numbered         "%opt{rp_pine}+i"
set-face global ts_markup_list_unchecked        "%opt{rp_foam}"
set-face global ts_markup_list_unnumbered       "%opt{rp_iris}"
set-face global ts_markup_link_label            "%opt{rp_pine}"
set-face global ts_markup_link_url              "%opt{rp_foam}+u"
set-face global ts_markup_link_uri              "%opt{rp_foam}+u"
set-face global ts_markup_link_text             "%opt{rp_pine}"
set-face global ts_markup_quote                 "%opt{rp_muted}"
set-face global ts_markup_raw                   "%opt{rp_foam}"
set-face global ts_markup_strikethrough         "%opt{rp_muted}+s"
set-face global ts_spell                        "%opt{rp_iris}"


# Code
set-face global value         "%opt{rp_gold}"
set-face global type          "%opt{rp_foam}"
set-face global variable      "%opt{rp_text}"
set-face global identifier    "%opt{rp_text}"
set-face global module        "%opt{rp_foam}"
set-face global function      "%opt{rp_rose}"
set-face global method        "%opt{rp_rose}"
set-face global string        "%opt{rp_gold}"
set-face global keyword       "%opt{rp_pine}"
set-face global operator      "%opt{rp_subtle}"
set-face global attribute     "%opt{rp_foam}"
set-face global comment       "%opt{rp_subtle}+i"
set-face global documentation "%opt{rp_documentation}"
set-face global meta          "%opt{rp_love}"
set-face global builtin       "%opt{rp_love}+b"
set-face global constant      "%opt{rp_gold}"
set-face global error         "%opt{rp_love}"

# Markup
set-face global title  "%opt{rp_pine}+b"
set-face global header "%opt{rp_foam}"
set-face global mono   "%opt{rp_muted}"
set-face global block  "%opt{rp_pine}"
set-face global link   "%opt{rp_pine}+u"
set-face global bullet "%opt{rp_gold}"
set-face global list   "%opt{rp_text}"

# UI
set-face global Default                "%opt{rp_text},%opt{rp_base}"
set-face global PrimarySelection       "%opt{rp_base},%opt{rp_selection}"
set-face global SecondarySelection     "%opt{rp_text},%opt{rp_selection_alt}"
set-face global PrimaryCursor          "%opt{rp_base},%opt{rp_text}+fg"
set-face global SecondaryCursor        "%opt{rp_base},%opt{rp_muted}+fg"
set-face global PrimaryCursorEol       "%opt{rp_base},%opt{rp_text}+fg"
set-face global SecondaryCursorEol     "%opt{rp_base},%opt{rp_muted}+fg"
set-face global MatchingChar           "%opt{rp_rose}+b"
set-face global MenuForeground         "%opt{rp_base},%opt{rp_pine}"
set-face global MenuBackground         "%opt{rp_text},%opt{rp_surface}"
set-face global MenuInfo               "%opt{rp_pine}"
set-face global Information            "%opt{rp_base},%opt{rp_gold}"
set-face global InlineInformation      "%opt{rp_text},%opt{rp_surface}"
set-face global Error                  "%opt{rp_base},%opt{rp_love}"
set-face global DiagnosticError        "%opt{rp_love}"
set-face global DiagnosticWarning      "%opt{rp_gold}"
set-face global StatusLine             "%opt{rp_subtle},%opt{rp_surface}"
set-face global StatusLineMode         "%opt{rp_subtle}+b"
set-face global StatusLineInfo         "%opt{rp_subtle}"
set-face global StatusLineValue        "%opt{rp_subtle}+b"
set-face global StatusCursor           "%opt{rp_base},%opt{rp_text}"
set-face global Prompt                 "%opt{rp_pine}"
set-face global BufferPadding          "%opt{rp_buffer_pad},%opt{rp_base}"
set-face global LineNumbers            "%opt{rp_muted},%opt{rp_base}"
set-face global LineNumberCursor       "%opt{rp_pine},%opt{rp_base}+b"
set-face global LineNumbersWrapped     "%opt{rp_muted},%opt{rp_base}+i"
set-face global Whitespace             "%opt{rp_overlay}+f"
set-face global WrapMarker             "%opt{rp_overlay}+f"
set-face global Search                 "%opt{rp_base},%opt{rp_gold}"
set-face global DiffAdd                "%opt{rp_iris},%opt{rp_diff_add_bg}"
set-face global DiffRm                 "%opt{rp_love},%opt{rp_diff_rm_bg}"
set-face global DiffMeta               "%opt{rp_pine},%opt{rp_diff_meta_bg}"
set-face global MercurialCommitComment "%opt{rp_subtle}"

set-face global InfoDefault               Information
set-face global InfoBlock                 Information
set-face global InfoBlockQuote            Information
set-face global InfoBullet                Information
set-face global InfoHeader                Information
set-face global InfoLink                  Information
set-face global InfoLinkMono              Information
set-face global InfoMono                  Information
set-face global InfoRule                  Information
set-face global InfoDiagnosticError       Information
set-face global InfoDiagnosticHint        Information
set-face global InfoDiagnosticInformation Information
set-face global InfoDiagnosticWarning     Information

