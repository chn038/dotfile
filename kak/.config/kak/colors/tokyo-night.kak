# Tokyo Night palette — default/night
declare-option str tn_base           "rgb:1a1b26"
declare-option str tn_surface        "rgb:1f2335"
declare-option str tn_overlay        "rgb:292e42"
declare-option str tn_muted          "rgb:565f89"
declare-option str tn_subtle         "rgb:9aa5ce"
declare-option str tn_text           "rgb:c0caf5"
declare-option str tn_love           "rgb:f7768e"
declare-option str tn_gold           "rgb:e0af68"
declare-option str tn_rose           "rgb:ff9e64"
declare-option str tn_pine           "rgb:7aa2f7"
declare-option str tn_foam           "rgb:7dcfff"
declare-option str tn_iris           "rgb:bb9af7"
declare-option str tn_green          "rgb:9ece6a"
declare-option str tn_highlight_low  "rgb:1f2335"
declare-option str tn_highlight_med  "rgb:292e42"
declare-option str tn_highlight_high "rgb:3b4261"
declare-option str tn_documentation  "rgb:a9b1d6"
declare-option str tn_selection      "rgb:283457"
declare-option str tn_selection_alt  "rgb:24283b"
declare-option str tn_diff_add_bg    "rgb:1e2b2e"
declare-option str tn_diff_rm_bg     "rgb:2d202e"
declare-option str tn_diff_meta_bg   "rgb:222436"
declare-option str tn_buffer_pad     "rgb:414868"


# Tree-sitter faces
set-face global ts_attribute                    "%opt{tn_gold}"
set-face global ts_comment                      "%opt{tn_muted}+i"
set-face global ts_comment_unused               "%opt{tn_muted}+is"
set-face global ts_conceal                      "%opt{tn_iris}+i"
set-face global ts_constant                     "%opt{tn_gold}"
set-face global ts_constant_builtin_boolean     "%opt{tn_rose}"
set-face global ts_constant_character           "%opt{tn_foam}"
set-face global ts_constant_macro               "%opt{tn_iris}"
set-face global ts_constructor                  "%opt{tn_foam}"
set-face global ts_diff_plus                    "%opt{tn_foam}"
set-face global ts_diff_minus                   "%opt{tn_love}"
set-face global ts_diff_delta                   "%opt{tn_pine}"
set-face global ts_diff_delta_moved             "%opt{tn_iris}"
set-face global ts_error                        "%opt{tn_love}+b"
set-face global ts_function                     "%opt{tn_pine}"
set-face global ts_function_builtin             "%opt{tn_pine}+i"
set-face global ts_function_macro               "%opt{tn_iris}"
set-face global ts_hint                         "%opt{tn_foam}+b"
set-face global ts_info                         "%opt{tn_foam}+b"
set-face global ts_keyword                      "%opt{tn_iris}"
set-face global ts_keyword_conditional          "%opt{tn_iris}+i"
set-face global ts_keyword_control_conditional  "%opt{tn_iris}+i"
set-face global ts_keyword_control_directive    "%opt{tn_iris}+i"
set-face global ts_keyword_control_import       "%opt{tn_iris}+i"
set-face global ts_keyword_directive            "%opt{tn_iris}+i"
set-face global ts_keyword_storage              "%opt{tn_iris}"
set-face global ts_keyword_storage_modifier     "%opt{tn_iris}"
set-face global ts_keyword_storage_modifier_mut "%opt{tn_iris}"
set-face global ts_keyword_storage_modifier_ref "%opt{tn_foam}"
set-face global ts_label                        "%opt{tn_foam}+i"
set-face global ts_namespace                    "%opt{tn_pine}+i"
set-face global ts_operator                     "%opt{tn_foam}"
set-face global ts_property                     "%opt{tn_foam}"
set-face global ts_punctuation                  "%opt{tn_subtle}"
set-face global ts_punctuation_special          "%opt{tn_foam}"
set-face global ts_special                      "%opt{tn_iris}"
set-face global ts_string                       "%opt{tn_green}"
set-face global ts_string_regex                 "%opt{tn_love}"
set-face global ts_string_regexp                "%opt{tn_love}"
set-face global ts_string_escape                "%opt{tn_gold}"
set-face global ts_string_special               "%opt{tn_iris}"
set-face global ts_string_special_path          "%opt{tn_foam}"
set-face global ts_string_special_symbol        "%opt{tn_iris}"
set-face global ts_string_symbol                "%opt{tn_rose}"
set-face global ts_tag                          "%opt{tn_iris}"
set-face global ts_tag_error                    "%opt{tn_love}"
set-face global ts_text                         "%opt{tn_text}"
set-face global ts_type                         "%opt{tn_foam}"
set-face global ts_type_enum_variant            "%opt{tn_rose}"
set-face global ts_type_enum_variant_builtin    "%opt{tn_rose}+i"
set-face global ts_variable                     "%opt{tn_text}"
set-face global ts_variable_builtin             "%opt{tn_rose}"
set-face global ts_variable_other_member        "%opt{tn_foam}"
set-face global ts_variable_parameter           "%opt{tn_gold}+i"
set-face global ts_warning                      "%opt{tn_gold}+b"

# Markup
set-face global ts_markup_bold                  "%opt{tn_gold}+b"
set-face global ts_markup_heading               "%opt{tn_foam}"
set-face global ts_markup_heading_1             "%opt{tn_iris}"
set-face global ts_markup_heading_2             "%opt{tn_foam}"
set-face global ts_markup_heading_3             "%opt{tn_pine}"
set-face global ts_markup_heading_4             "%opt{tn_gold}"
set-face global ts_markup_heading_5             "%opt{tn_rose}"
set-face global ts_markup_heading_6             "%opt{tn_foam}"
set-face global ts_markup_heading_marker        "%opt{tn_gold}+b"
set-face global ts_markup_italic                "%opt{tn_rose}+i"
set-face global ts_markup_list_checked          "%opt{tn_foam}"
set-face global ts_markup_list_numbered         "%opt{tn_pine}+i"
set-face global ts_markup_list_unchecked        "%opt{tn_foam}"
set-face global ts_markup_list_unnumbered       "%opt{tn_iris}"
set-face global ts_markup_link_label            "%opt{tn_pine}"
set-face global ts_markup_link_url              "%opt{tn_foam}+u"
set-face global ts_markup_link_uri              "%opt{tn_foam}+u"
set-face global ts_markup_link_text             "%opt{tn_pine}"
set-face global ts_markup_quote                 "%opt{tn_muted}"
set-face global ts_markup_raw                   "%opt{tn_foam}"
set-face global ts_markup_strikethrough         "%opt{tn_muted}+s"
set-face global ts_spell                        "%opt{tn_iris}"


# Code
set-face global value         "%opt{tn_gold}"
set-face global type          "%opt{tn_foam}"
set-face global variable      "%opt{tn_text}"
set-face global identifier    "%opt{tn_text}"
set-face global module        "%opt{tn_foam}"
set-face global function      "%opt{tn_pine}"
set-face global method        "%opt{tn_pine}"
set-face global string        "%opt{tn_green}"
set-face global keyword       "%opt{tn_iris}"
set-face global operator      "%opt{tn_subtle}"
set-face global attribute     "%opt{tn_foam}"
set-face global comment       "%opt{tn_muted}+i"
set-face global documentation "%opt{tn_documentation}"
set-face global meta          "%opt{tn_love}"
set-face global builtin       "%opt{tn_rose}+b"
set-face global constant      "%opt{tn_gold}"
set-face global error         "%opt{tn_love}"

# Markup
set-face global title  "%opt{tn_pine}+b"
set-face global header "%opt{tn_foam}"
set-face global mono   "%opt{tn_subtle}"
set-face global block  "%opt{tn_pine}"
set-face global link   "%opt{tn_foam}+u"
set-face global bullet "%opt{tn_gold}"
set-face global list   "%opt{tn_text}"

# UI
set-face global Default                "%opt{tn_text},%opt{tn_base}"
set-face global PrimarySelection       "%opt{tn_text},%opt{tn_selection}"
set-face global SecondarySelection     "%opt{tn_text},%opt{tn_selection_alt}"
set-face global PrimaryCursor          "%opt{tn_base},%opt{tn_text}+fg"
set-face global SecondaryCursor        "%opt{tn_base},%opt{tn_subtle}+fg"
set-face global PrimaryCursorEol       "%opt{tn_base},%opt{tn_text}+fg"
set-face global SecondaryCursorEol     "%opt{tn_base},%opt{tn_subtle}+fg"
set-face global MatchingChar           "%opt{tn_gold}+b"
set-face global MenuForeground         "%opt{tn_base},%opt{tn_pine}"
set-face global MenuBackground         "%opt{tn_text},%opt{tn_surface}"
set-face global MenuInfo               "%opt{tn_foam}"
set-face global Information            "%opt{tn_base},%opt{tn_gold}"
set-face global InlineInformation      "%opt{tn_text},%opt{tn_surface}"
set-face global Error                  "%opt{tn_base},%opt{tn_love}"
set-face global DiagnosticError        "%opt{tn_love}"
set-face global DiagnosticWarning      "%opt{tn_gold}"
set-face global StatusLine             "%opt{tn_subtle},%opt{tn_surface}"
set-face global StatusLineMode         "%opt{tn_subtle}+b"
set-face global StatusLineInfo         "%opt{tn_subtle}"
set-face global StatusLineValue        "%opt{tn_subtle}+b"
set-face global StatusCursor           "%opt{tn_base},%opt{tn_text}"
set-face global Prompt                 "%opt{tn_pine}"
set-face global BufferPadding          "%opt{tn_buffer_pad},%opt{tn_base}"
set-face global LineNumbers            "%opt{tn_muted},%opt{tn_base}"
set-face global LineNumberCursor       "%opt{tn_pine},%opt{tn_base}+b"
set-face global LineNumbersWrapped     "%opt{tn_muted},%opt{tn_base}+i"
set-face global Whitespace             "%opt{tn_overlay}+f"
set-face global WrapMarker             "%opt{tn_overlay}+f"
set-face global Search                 "%opt{tn_base},%opt{tn_gold}"
set-face global DiffAdd                "%opt{tn_foam},%opt{tn_diff_add_bg}"
set-face global DiffRm                 "%opt{tn_love},%opt{tn_diff_rm_bg}"
set-face global DiffMeta               "%opt{tn_pine},%opt{tn_diff_meta_bg}"
set-face global MercurialCommitComment "%opt{tn_subtle}"

set-face global InfoDefault               Information
set-face global InfoBlock                 Information
set-face global InfoBlockQuote            Information
set-face global InfoBullet                Information
set-face global InfoHeader                Information
set-face global InfoLink                  Information
set-face global InfoLinkMono              Information
set-face global InfoMono                  Information
set-face global InfoRule                  Information
set-face global InfoDiagnosticError       Information
set-face global InfoDiagnosticHint        Information
set-face global InfoDiagnosticInformation Information
set-face global InfoDiagnosticWarning     Information

